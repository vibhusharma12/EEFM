# Copy to .env to override defaults (all optional).

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds to wait for Yahoo Finance.
UPSTREAM_TIMEOUT=10

# In-memory cache lifetimes (seconds).
CACHE_TTL_SECONDS=300
NEGATIVE_CACHE_TTL_SECONDS=60

# Where trained models are saved (Joblib). Set PERSIST_MODELS=false to keep them in memory only.
PERSIST_MODELS=true
